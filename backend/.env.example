# ===========================================================================
# AI Operations Agent - Backend Configuration
# Copy this file to .env (same folder) and adjust values.
# Never commit a real .env file or real secrets.
# ===========================================================================

# --- Database -----------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db

# --- Security -------------------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (frontend dev server) ---------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI Provider --------------------------------------------------------------
# Supported: "ollama" (local, default) | "none" (agent disabled gracefully)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Future hosted providers (left blank by default; never commit real keys)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- File uploads -------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# --- Agent safety limits -------------------------------------------------------
AGENT_MAX_ITERATIONS=8
AGENT_TIMEOUT_SECONDS=60
