# =============================================================================
# ARyzz AI Solutions platform — environment variables
# Copy to .env.local for local development. In production set these in
# Vercel → Project → Settings → Environment Variables. Never commit real keys.
# =============================================================================

# Public site URL (no trailing slash). Used for emails, redirects and SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional fallback contact email shown before you fill in Admin → Settings.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_...) or legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_...) or legacy "service_role" key. SERVER ONLY.
SUPABASE_SECRET_KEY=

# --- Stripe (Developers → API keys / Webhooks) -------------------------------
# Use sk_test_... until you have tested end to end, then switch to sk_live_...
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) — optional but recommended -------------------------------
RESEND_API_KEY=
# Must use a domain you verified in Resend, e.g. "ARyzz AI Solutions <hello@yourdomain.com>"
EMAIL_FROM=
# Where owner alerts / daily digest are sent.
ADMIN_NOTIFICATION_EMAIL=

# --- AI assistant (Anthropic) — optional -------------------------------------
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. For lower cost you can set claude-sonnet-5-5 or claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5

# --- Cron ---------------------------------------------------------------------
# Random string (e.g. `openssl rand -hex 32`). Vercel Cron sends it automatically
# as "Authorization: Bearer <CRON_SECRET>" when the env var is set.
CRON_SECRET=
